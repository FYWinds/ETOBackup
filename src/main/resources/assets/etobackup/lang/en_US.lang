# --- config screen ---
etobackup.config.title=ETOBackup
etobackup.config.server=Server
etobackup.config.server.tooltip=The server's backups. In single player these apply to the worlds you play.
etobackup.config.client=This Computer
etobackup.config.client.tooltip=This computer's own settings.
etobackup.config.enabled=Timed Snapshots
etobackup.config.enabled.tooltip=Take snapshots of the world on a timer. Off: only /etobackup now takes one.
etobackup.config.intervalMinutes=Interval (minutes)
etobackup.config.intervalMinutes.tooltip=Minutes between snapshots while a player is or was online since the last one.
etobackup.config.idleIntervalMinutes=Idle Interval (minutes)
etobackup.config.idleIntervalMinutes.tooltip=Minutes between snapshots while no player has been online since the last one. 0: none are taken then.
etobackup.config.directory=Repository
etobackup.config.directory.tooltip=Where snapshots are stored, relative to the server directory or absolute. In single player each world gets its own repository below it. Takes effect when the server or world starts.
etobackup.config.extraPaths=Extra Paths
etobackup.config.extraPaths.tooltip=Files and directories backed up besides the world, relative to the server directory (in single player, the game directory). Missing ones are skipped.
etobackup.config.exclude=Excluded Paths
etobackup.config.exclude.tooltip=Paths left out with everything below them, relative to the server directory (in single player, the game directory).
etobackup.config.keepAllHours=Keep All (hours)
etobackup.config.keepAllHours.tooltip=Every snapshot of this many hours before the newest one is kept.
etobackup.config.keepHourly=Keep Hourly
etobackup.config.keepHourly.tooltip=The last snapshot of each hour is kept, for this many hours that have one.
etobackup.config.keepDaily=Keep Daily
etobackup.config.keepDaily.tooltip=The last snapshot of each day is kept, for this many days that have one.
etobackup.config.keepWeekly=Keep Weekly
etobackup.config.keepWeekly.tooltip=The last snapshot of each week is kept, for this many weeks that have one.
etobackup.config.keepMonthly=Keep Monthly
etobackup.config.keepMonthly.tooltip=The last snapshot of each month is kept, for this many months that have one.
etobackup.config.maxAgeDays=Maximum Age (days)
etobackup.config.maxAgeDays.tooltip=Snapshots more than this many days older than the newest one are dropped, whatever the keep rules say. 0: no limit.
etobackup.config.keepPreRollbackDays=Keep Before-Rollback Snapshots (days)
etobackup.config.keepPreRollbackDays.tooltip=The snapshot taken just before a rollback is kept for this many days whatever the keep rules say, so that the rollback can be undone.
etobackup.config.rollbackDelaySeconds=Rollback Countdown (seconds)
etobackup.config.rollbackDelaySeconds.tooltip=Seconds between a rollback being announced and the server stopping for it (in single player: the world closing) while other players are online. Alone, the player who asked waits 5 seconds.
etobackup.config.screenshots=Snapshot Pictures
etobackup.config.screenshots.tooltip=Keep a picture of your screen for every snapshot taken while you play; the backup screen shows it. Stored on this computer only.
etobackup.config.screenshotWidth=Picture Width
etobackup.config.screenshotWidth.tooltip=Width of those pictures in pixels.
etobackup.config.pauseMenuButton=Pause Menu Button
etobackup.config.pauseMenuButton.tooltip=Show a Backups button in the pause menu. The key binding opens the backup screen either way.
